# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your real deployed domain (e.g. https://splithairstudio.com) -- required
# for Tamara's redirect/webhook URLs, which can't point at localhost.
NEXT_PUBLIC_SITE_URL=
# Tamara's *publishable* widget key (safe client-side) -- shows the real
# "pay in X" price breakdown on the booking screen. Different from
# TAMARA_API_TOKEN below, which is secret and server-only.
NEXT_PUBLIC_TAMARA_PUBLIC_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in a Client Component
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Tamara (BNPL) -- see lib/payments/tamaraClient.ts
TAMARA_API_BASE_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=
# Any string you make up yourself -- register it as the webhook's
# "authorization" header value (registerTamaraWebhook), then Tamara echoes
# it back on every webhook call so we can confirm the call is really theirs.
TAMARA_WEBHOOK_SECRET=

# Edge Function secrets (set via `supabase secrets set`, not here, in production)
# WHATSAPP_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
